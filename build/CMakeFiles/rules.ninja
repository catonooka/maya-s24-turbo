#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = /home/aisever/project-maya/.venv/lib/python3.11/site-packages/cmake/data/bin/cmake --regenerate-during-build -S/home/aisever/project-maya -B/home/aisever/project-maya/build
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = /home/aisever/project-maya/.venv/bin/ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


#############################################
# Rule for printing all primary targets available.

rule HELP
  command = /home/aisever/project-maya/.venv/bin/ninja -t targets
  description = All primary targets available:

